@model JobViewModel

@{
    ViewData["Title"] = "Job Title at Company";
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <article>
            <section class="govuk-!-margin-bottom-6" style="position:relative">
                <img class="logo govuk-!-margin-bottom-3" src="/assets/images/govuk-icon-180.png" alt="Department logo" style="width:48px">
                <h2 class="govuk-heading-m">@Model.JobDescription.Company</h2>
                <p class="govuk-hint govuk-!-margin-bottom-1">
                    @Model.JobDescription.Website
                </p>
                <a class="govuk-button govuk-button--secondary" href="#"
                    style="position:absolute; right:0; top:25%;">Company Site</a>
            </section>

            <header class="govuk-!-margin-bottom-6">
                <p class="govuk-hint govuk-!-margin-bottom-1">
                    @Model.JobDescription.PostedAt • @Model.JobDescription.Contract
                </p>
                <h1 class="govuk-heading-l govuk-!-margin-bottom-2">@Model.JobDescription.Position</h1>
                <h3 class="govuk-heading-s govuk-!-margin-bottom-0">@Model.JobDescription.Location</h3>
            </header>

            <section>
                <p class="govuk-body">@Model.JobDescription.Description</p>
            </section>

            <section>
                <h2 class="govuk-heading-m">Requirements</h2>
                <p class="govuk-body">@Model.JobDescription.Requirements.Content</p>
                <ul class="govuk-list govuk-list--bullet">
                    @foreach (var item in Model.JobDescription.Requirements.Items)
                    {
                        <li>@item</li>
                    }
                </ul>
            </section>

            <section>
                <h2 class="govuk-heading-m">What You Will Do</h2>
                <p class="govuk-body">@Model.JobDescription.Role.Content</p>
                <ol class="govuk-list govuk-list--number">
                    @foreach (var item in Model.JobDescription.Role.Items)
                    {
                        <li>@item</li>
                    }
                </ol>
            </section>

            <hr class="govuk-section-break govuk-!-margin-top-9 govuk-!-margin-bottom-4 govuk-section-break--visible">

            <footer style="position:relative">
                <h2 class="govuk-heading-m govuk-!-margin-bottom-1">@Model.JobDescription.Position</h2>
                <p class="govuk-hint govuk-!-margin-0">@Model.JobDescription.Company</p>

                <a class="govuk-button" href="#" style="position:absolute; right:0; top:25%;">Apply Now</a>
            </footer>
        </article>
    </div>
</div>
