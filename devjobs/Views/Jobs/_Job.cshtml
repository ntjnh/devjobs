<div class="govuk-grid-column-one-third govuk-!-margin-bottom-6">
    <article class="job govuk-!-padding-4">
        <span class="logo-box" style="background-color: @Model.LogoBackground">
            <img class="logo" src="@Model.Logo" alt="@Model.Company logo" />
        </span>

        <p class="govuk-hint govuk-!-font-size-16 govuk-!-margin-bottom-1">
            @Model.PostedAt • @Model.Contract
        </p>
        <h3 class="govuk-heading-s govuk-!-margin-bottom-0">
            <a class="govuk-link" href="/Jobs/@Model.Id">
                @Model.Position
            </a>
        </h3>
        <h4 class="govuk-hint govuk-!-font-size-16 govuk-!-margin-top-1 govuk-!-margin-bottom-6">@Model.Company</h4>
        <h5 class="govuk-body-s govuk-!-font-weight-bold govuk-!-margin-bottom-0">@Model.Location</h5>
    </article>
</div>